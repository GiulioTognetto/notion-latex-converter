{
  "manifest_version": 3,
  "name": "Notion Auto LaTeX Converter",
  "version": "2.1",
  "description": "Converts raw LaTeX syntax into native Notion formula blocks using the official Notion API.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://api.notion.com/*",
    "https://*.notion.so/*",
    "https://*.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://app.notion.com/*",
        "https://*.notion.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}